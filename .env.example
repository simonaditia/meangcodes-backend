# PostgreSQL DSN for Gorm
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edutech_portal?sslmode=disable"
PORT=8080
JWT_SECRET="ganti-dengan-secret-random-panjang"
ADMIN_EMAIL="you@example.com" # dipakai untuk bootstrap akun admin ke tabel users
ADMIN_PASSWORD="ganti-password-login" # akan di-hash bcrypt ke users.password_hash
ADMIN_NAME="Your Name"
JWT_TTL_HOURS=24
