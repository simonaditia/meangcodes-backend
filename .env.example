# PostgreSQL DSN for Gorm (boleh pakai Supabase direct connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edutech_portal?sslmode=disable"
# Optional fallback jika DATABASE_URL kosong
SUPABASE_DATABASE_URL=""

# Supabase project settings untuk media storage
SUPABASE_STORAGE_ENABLED="false"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# Comma-separated allowed origins for CORS
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

PORT=8080
JWT_SECRET="ganti-dengan-secret-random-panjang"
ADMIN_EMAIL="you@example.com" # dipakai untuk bootstrap akun admin ke tabel users
ADMIN_PASSWORD="ganti-password-login" # akan di-hash bcrypt ke users.password_hash
ADMIN_NAME="Your Name"
JWT_TTL_HOURS=24
